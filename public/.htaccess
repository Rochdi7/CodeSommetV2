<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical host: redirect www to the apex domain (no-op today since
    # www.codesommet.com has no DNS record, kept as insurance if that changes).
    RewriteCond %{HTTP_HOST} ^www\.codesommet\.com$ [NC]
    RewriteRule ^(.*)$ https://codesommet.com/$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compress dynamic HTML/JSON responses. Static assets (css/js/fonts) are
# already served brotli-compressed by LiteSpeed directly; this only covers
# the PHP-rendered HTML document, which currently returns uncompressed
# (verified via curl --compressed against the live homepage).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/json application/xml
</IfModule>

# ── Static asset caching ────────────────────────────────────────────────
# CSS/JS are referenced with ?v=<filemtime> (asset_v() helper), so a file
# change changes the URL: safe to cache "forever". Images and fonts are
# unversioned; they get a long-but-revalidatable lifetime instead of the
# host's 7-day default (OTF previously had no caching at all).
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/otf .otf
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2|otf|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
